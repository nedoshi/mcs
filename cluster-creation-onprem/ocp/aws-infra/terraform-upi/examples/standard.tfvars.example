# Infrastructure only (recommended first step)
cluster_name = "ocp-lab"
base_domain  = "example.com"
region       = "us-east-1"

tags = {
  owner       = "platform-team"
  environment = "lab"
}

az_count = 3

# Route53 public zone for api.<cluster>.<domain>
public_hosted_zone_id     = "Z0123456789ABCDEFGHIJ"
create_public_dns_records = true

# Leave false until infrastructure is validated, then re-apply with true
enable_cluster_install = false

# --- Full install (enable_cluster_install = true) ---
# openshift_pull_secret_path = "./openshift_pull_secret.json"
# ssh_public_key             = "ssh-ed25519 AAAA... user@host"
#
# control_plane = {
#   count         = 3
#   instance_type = "m6i.xlarge"
#   disk_gb       = 120
# }
#
# bootstrap = {
#   instance_type = "m6i.xlarge"
# }
