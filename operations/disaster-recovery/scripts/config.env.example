# Cross-cloud DR validation configuration
# Copy to config.env and fill in values:
#   cp config.env.example config.env

# oc config context names (oc config get-contexts)
PRIMARY_CONTEXT="prod-aro-primary/admin"
DR_CONTEXT="prod-rosa-dr/admin"

# Test workload
TEST_NAMESPACE="dr-validation"

# OADP / Velero
OADP_NAMESPACE="openshift-adp"
BACKUP_NAME_PREFIX="dr-validation"

# StorageClass mapping for cross-cloud restore
# ARO primary → ROSA DR:
STORAGE_CLASS_MAPPINGS="managed-csi=gp3-csi-kms,managed-premium=gp3-csi-kms"
# ROSA primary → ARO DR (uncomment instead):
# STORAGE_CLASS_MAPPINGS="gp3-csi-kms=managed-csi,gp3-csi=managed-csi"

# GitOps
GITOPS_NAMESPACE="openshift-gitops"

# Optional: ACM hub context for GitOps placement checks
# HUB_CONTEXT="acm-hub/admin"

# Results log (auto-timestamped if unset)
# RESULTS_FILE="./results/dr-validation.log"

# RTO target in minutes (for pass/fail reporting)
RTO_TARGET_MINUTES=120
