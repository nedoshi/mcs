# ROSA HCP with customer-managed KMS + etcd encryption
# Auth: TF_VAR_client_id + TF_VAR_client_secret (recommended) or TF_VAR_token (optional)
# make plan TFVARS=examples/kms.tfvars.example

cluster_name = "mobb-kms-rosa"
region       = "us-east-1"

tags = {
  app-code      = "MOBB-001"
  service-phase = "lab"
  cost-center   = "468"
  owner         = "nedoshi_mobb"
}

private  = false
multi_az = false
replicas = 2

compute_machine_type = "m5.xlarge"
create_account_roles = true

cluster_kms_mode = "create"
etcd_encryption  = true

# cluster_kms_mode    = "existing"
# cluster_kms_key_arn = "arn:aws:kms:us-east-1:ACCOUNT_ID:key/..."
