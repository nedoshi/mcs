# Public ROSA HCP with HTPasswd admin + developer users
# Auth: TF_VAR_client_id + TF_VAR_client_secret (recommended) or TF_VAR_token (optional)
# make plan TFVARS=examples/htpasswd.tfvars.example

cluster_name = "mobb-idp-rosa"
region       = "us-east-1"

tags = {
  app-code      = "MOBB-001"
  service-phase = "lab"
  cost-center   = "468"
  owner         = "nedoshi_mobb"
}

private  = false
multi_az = false
replicas = 2

compute_machine_type = "m5.xlarge"
create_account_roles = true

# Set via env (recommended): export TF_VAR_admin_password=... TF_VAR_developer_password=...
# admin_password     = "ChangeMe-Admin1!"
# developer_password = "ChangeMe-Dev1!"
