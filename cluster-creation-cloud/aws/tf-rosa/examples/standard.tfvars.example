# Public ROSA HCP — standard lab cluster
# Auth: TF_VAR_client_id + TF_VAR_client_secret (recommended) or TF_VAR_token (optional)
# make plan TFVARS=examples/standard.tfvars.example

cluster_name = "nddemo"
region       = "us-east-1"

tags = {
  app-code      = "MOBB-001"
  service-phase = "lab"
  cost-center   = "468"
  owner         = "nedoshi_mobb"
}

private  = false
multi_az = false
replicas = 2

compute_machine_type = "m5.xlarge"
create_account_roles = true

# client_id + client_secret via TF_VAR_* (recommended) or TF_VAR_token (optional)

# admin_password     = "ChangeMe-Admin1!"
# developer_password = "ChangeMe-Dev1!"
